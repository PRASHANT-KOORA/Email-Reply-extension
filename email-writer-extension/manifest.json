{
  "name": "Email Writer Assistant",
  "description": "AI-powered email reply generator",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "*://mail.google.com/*"
  ],
  "icons": {
    "16": "icons/Emaillogo.png",
    "48": "icons/Emaillogo.png",
    "128": "icons/Emaillogo.png"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["*://mail.google.com/*"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Email Writer Assistant",
    "default_icon": {
      "16": "icons/Emaillogo.png",
      "48": "icons/Emaillogo.png",
      "128": "icons/Emaillogo.png"
    }
  }
}